# Modelo do arquivo .env

# Senha do root do MySQL. Usada só pelo Docker para montar o banco.
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# Conexão da API com o banco (usuário com privilégios mínimos).
# O usuário app_fincore é criado pelo script sql/04_usuarios_acesso.sql.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=fincore
DB_USER=app_fincore
DB_PASSWORD=troque_esta_senha_app

# Senhas dos outros usuários do MySQL (criados pelo 04_usuarios_acesso.sql).
# analista_fincore: somente leitura. dba_fincore: administra só o banco fincore.
DB_ANALISTA_PASSWORD=troque_esta_senha_analista
DB_DBA_PASSWORD=troque_esta_senha_dba

